---
import { getCollection, render } from "astro:content";
import "katex/dist/katex.min.css";
import katex from "katex";

import Nav from "../../components/Nav.astro";

import fes from "../../../../data/fe_database.json";
import references from "../../../../data/fe_references.json";


function renderInlineMath(math) {
  return katex.renderToString(math, {
    throwOnError: false,
    displayMode: false,
  });
}


function renderEquation(equation) {
  return katex.renderToString(equation.display, {
    throwOnError: false,
    displayMode: true,
  });
}


export function getStaticPaths() {
  return fes.map((fe) => ({
    params: {
      id: fe.id.replace("FE-", ""),
    },

    props: {
      fe,
    },
  }));
}


const { fe } = Astro.props;


const solutionEntries =
  await getCollection("solutions");


const solutionEntry =
  solutionEntries.find(
    (entry) => entry.id === fe.id
  );


const status =
  solutionEntry?.data.status ?? "open";


const feReferences =
  references[
    fe.id as keyof typeof references
  ] ?? [];


let SolutionContent = null;

if (solutionEntry) {
  const rendered =
    await render(solutionEntry);

  SolutionContent =
    rendered.Content;
}
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width"
    />

    <title>
      #{Number(fe.id.replace("FE-", ""))}
      | Functional Equation Database
    </title>
  </head>

  <body>
    <main>
      <Nav />

      <!-- Problem number + status -->

      <div class="problem-header">
        <h1>
          #{Number(fe.id.replace("FE-", ""))}
        </h1>

        <div class={`status-box ${status}`}>
          <strong>{status}</strong>
        </div>
      </div>


      <!-- Problem statement -->

      <div class=`problem-box ${status}`>
        <p class="problem-text">
          Find all functions{" "}

          <span
            set:html={renderInlineMath(
              "f:\\mathbb{R}\\to\\mathbb{R}"
            )}
          />

          {" "}such that
        </p>

        <div
          class="equation"
          set:html={renderEquation(
            fe.equations[0]
          )}
        />

        <p class="problem-text final-line">
          for any reals{" "}

          <span
            set:html={renderInlineMath("x,y")}
          />.
        </p>
      </div>


      <!-- Known appearances -->

      {
        feReferences.length > 0 && (
          <section class="references-section">
            <h2>Known appearances</h2>

            <div class="references-list">
              {
                feReferences.map((ref) => (
                  <a
                    class={`reference-item ${ref.type}`}
                    href={ref.url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <span class="reference-type">
                      {
                        ref.type === "contest"
                          ? "Contest"
                          : "AoPS"
                      }
                    </span>

                    <span class="reference-label">
                      {ref.label}
                    </span>

                    <span class="reference-arrow">
                      ↗
                    </span>
                  </a>
                ))
              }
            </div>
          </section>
        )
      }


      <!-- Solution -->

      <section class="content-section">
        <h2>Solution</h2>

        <div class="content-box">
          {
            SolutionContent
              ? <SolutionContent />
              : <p>No solution yet.</p>
          }
        </div>
      </section>
    </main>


    <style>
      body {
        font-family:
          system-ui,
          sans-serif;

        margin: 0;

        background: #f5f5f5;
        color: #111;
      }


      main {
        max-width: 900px;

        margin: 0 auto;

        padding:
          40px
          20px;
      }


      a {
        color: inherit;
      }


      /* -------------------------
         Problem header
         ------------------------- */

      .problem-header {
        display: grid;

        grid-template-columns:
          1fr
          auto;

        align-items: center;

        width: 100%;

        gap: 20px;

        margin-bottom: 24px;
      }


      .problem-header h1 {
        margin: 0;
      }


      .problem-header .status-box {
        justify-self: end;
      }


      /* -------------------------
         Status
         ------------------------- */

      .status-box {
        display: inline-flex;

        align-items: center;
        justify-content: center;

        padding:
          7px
          13px;

        background: white;

        border:
          1px solid #ddd;

        border-radius: 8px;

        font-size: 0.95rem;
      }


      .status-box strong {
        text-transform: capitalize;
      }


      .status-box.open {
        border-color: #e2b5b5;
        background: #fffafa;
      }


      .status-box.open strong {
        color: #c62828;
      }


      .status-box.solved {
        border-color: #b8d8bb;
        background: #fbfffb;
      }


      .status-box.solved strong {
        color: #2e7d32;
      }


      /* -------------------------
         Problem statement
         ------------------------- */

        .problem-box {
        padding:
            26px
            28px;

        border-radius: 12px;

        margin-bottom: 20px;

        border: 1px solid transparent;
        }

        .problem-box.open {
        background: #fff1f1;
        border-color: #f0cccc;
        }

        .problem-box.solved {
        background: #f0f9f1;
        border-color: #c9e3cc;
        }


      .problem-text {
        margin:
          0
          0
          18px;

        font-size: 1.05rem;

        line-height: 1.6;
      }


      .problem-text.final-line {
        margin-top: 18px;
        margin-bottom: 0;
      }


      .equation {
        font-size: 1.2rem;

        overflow-x: auto;
      }


      /* -------------------------
         Known appearances
         ------------------------- */

      .references-section {
        margin-top: 32px;
      }


      .references-section h2 {
        margin-bottom: 14px;
      }


      .references-list {
        display: grid;

        gap: 8px;
      }


      .reference-item {
        display: grid;

        grid-template-columns:
          auto
          1fr
          auto;

        align-items: center;

        gap: 12px;

        padding:
          12px
          14px;

        background: white;

        border:
          1px solid #e2e2e2;

        border-radius: 9px;

        text-decoration: none;
      }


      .reference-item:hover {
        background: #fafafa;
      }


      .reference-type {
        padding:
          4px
          8px;

        border-radius: 999px;

        font-size: 0.75rem;

        font-weight: 600;
      }


      .reference-item.contest
      .reference-type {
        background: #eef3ff;
        color: #3451a3;
      }


      .reference-item.aops
      .reference-type {
        background: #fff4e5;
        color: #9a5b00;
      }


      .reference-label {
        font-weight: 500;
      }


      .reference-arrow {
        color: #888;
      }


      /* -------------------------
         Solution
         ------------------------- */

      .content-section {
        margin-top: 32px;
      }


      h2 {
        margin-top: 0;
        margin-bottom: 16px;
      }


      .content-box {
        background: white;

        padding: 24px;

        border-radius: 12px;
      }


      /* -------------------------
         Mobile
         ------------------------- */

      @media (max-width: 600px) {

        main {
          padding:
            24px
            14px;
        }


        .problem-header {
          grid-template-columns:
            1fr
            auto;

          gap: 12px;

          margin-bottom: 18px;
        }


        .problem-header h1 {
          font-size: 1.7rem;
        }


        .status-box {
          padding:
            6px
            10px;

          font-size: 0.9rem;
        }


        .problem-box {
          padding:
            20px
            16px;
        }


        .equation {
          font-size: 1rem;
        }


        .content-box {
          padding: 18px;
        }


        .reference-item {
          grid-template-columns:
            auto
            1fr
            auto;

          gap: 8px;

          padding:
            10px
            12px;
        }


        .reference-label {
          font-size: 0.9rem;
        }
      }
    </style>
  </body>
</html>