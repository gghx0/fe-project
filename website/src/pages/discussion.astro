---
import Nav from "../components/Nav.astro";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Discussion | Functional Equation Database</title>
  </head>

  <body>
    <main>
      <Nav />

      <h1>Discussion</h1>

      <p class="intro">
        Use this page to discuss FEs,
        share solutions, progress or corrections.
        Please mention the problem number in your comment. AI usage is allowed but shouuld be declared.
        <br><br>
        To message me privately, DM @gghx on Discord.
      </p>

      <div class="discussion-box">
        <script
          src="https://giscus.app/client.js"
          data-repo="gghx0/fe-project"
          data-repo-id="R_kgDOT03LxA"
          data-category="General"
          data-category-id="DIC_kwDOT03LxM4DDH0b"
          data-mapping="pathname"
          data-strict="1"
          data-reactions-enabled="0"
          data-emit-metadata="0"
          data-input-position="top"
          data-theme="light"
          data-lang="en"
          crossorigin="anonymous"
          async>
        </script>
      </div>
    </main>

    <style>
      body {
        font-family: system-ui, sans-serif;
        margin: 0;
        background: #f5f5f5;
        color: #111;
      }

      main {
        max-width: 900px;
        margin: 0 auto;
        padding: 20px;
      }

      .intro {
        line-height: 1.6;
        color: #555;
        margin-bottom: 28px;
      }

      .discussion-box {
        background: white;
        padding: 24px;
        border-radius: 12px;
      }
    </style>
  </body>
</html>