---
import Nav from "../components/Nav.astro";

const googleFormStandaloneUrl =
  "https://docs.google.com/forms/d/e/1FAIpQLSedEmZ6djphOrY95IXZCJ0bRgn6OCFELjSm2sfgyVYxd2rKMA/viewform";

const googleFormUrl =
  `${googleFormStandaloneUrl}?embedded=true`;

const pendingSubmissionsEndpoint =
  "https://script.google.com/macros/s/AKfycbxcT6D7p1p3-pwJRxM9qdg-u0_J9Y1Eaaz0RUs57-_IKbualveIDwGmslmbyEJ7tT3F/exec";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width"
    />

    <title>
      Submit a Solution | Functional Equation Database
    </title>
  </head>

  <body>
    <main>
      <Nav />

      <h1>Submit a Solution</h1>

      <section
        class="pending-panel"
        data-endpoint={pendingSubmissionsEndpoint}
        data-base={base}
        aria-labelledby="pending-submissions-heading"
      >
        <div class="pending-header">
          <div>
            <h2 id="pending-submissions-heading">
              Pending Submissions
            </h2>

            <p data-pending-count>
              Loading...
            </p>
          </div>

          <div class="pending-actions">
            <button
              class="toggle-pending-button"
              type="button"
              data-toggle-pending
              aria-expanded="true"
              aria-controls="pending-submissions-content"
            >
              Hide pending submissions
            </button>

            <button
              class="refresh-button"
              type="button"
              data-refresh-submissions
            >
              Refresh
            </button>
          </div>
        </div>

        <div
          id="pending-submissions-content"
          class="pending-content"
          data-pending-content
        >
          <p
            class="pending-status"
            data-pending-status
            role="status"
          >
            Loading pending submissions...
          </p>

          <div
            class="pending-list"
            data-pending-list
            hidden
          >
          </div>
        </div>
      </section>

      <section class="form-panel">
        <iframe
          src={googleFormUrl}
          title="Submit a Solution Google Form"
          width="640"
          height="689"
          frameborder="0"
          marginheight="0"
          marginwidth="0"
        >
          Loading...
        </iframe>
      </section>

      <p class="fallback-link">
        <a
          href={googleFormStandaloneUrl}
          target="_blank"
          rel="noreferrer"
        >
          Open the form in a new tab
        </a>
      </p>
    </main>

    <script>
      const pendingPanel =
        document.querySelector(".pending-panel");

      if (pendingPanel instanceof HTMLElement) {
        const endpoint =
          pendingPanel.dataset.endpoint ?? "";

        const base =
          (pendingPanel.dataset.base ?? "").replace(/\/$/, "");

        const statusElement =
          pendingPanel.querySelector("[data-pending-status]");

        const countElement =
          pendingPanel.querySelector("[data-pending-count]");

        const pendingContent =
          pendingPanel.querySelector("[data-pending-content]");

        const listElement =
          pendingPanel.querySelector("[data-pending-list]");

        const togglePendingButton =
          pendingPanel.querySelector("[data-toggle-pending]");

        const refreshButton =
          pendingPanel.querySelector("[data-refresh-submissions]");

        const statusLabelsToHide = new Set([
          "accepted",
          "approved",
          "closed",
          "complete",
          "completed",
          "deleted",
          "done",
          "published",
          "rejected",
          "solved",
          "verified",
        ]);

        function setStatus(message) {
          if (statusElement) {
            statusElement.textContent = message;
          }
        }

        function setPendingVisibility(isVisible) {
          if (pendingContent instanceof HTMLElement) {
            pendingContent.hidden =
              !isVisible;
          }

          if (togglePendingButton instanceof HTMLElement) {
            togglePendingButton.textContent =
              isVisible
                ? "Hide pending submissions"
                : "Show pending submissions";

            togglePendingButton.setAttribute(
              "aria-expanded",
              String(isVisible)
            );
          }
        }

        function normalizeRows(rows) {
          if (
            rows.length === 0 ||
            !rows.every(Array.isArray)
          ) {
            return rows;
          }

          const [headers, ...bodyRows] =
            rows;

          return bodyRows.map((row) =>
            Object.fromEntries(
              headers.map((header, index) => [
                String(header),
                row[index] ?? "",
              ])
            )
          );
        }

        function getRows(payload) {
          if (Array.isArray(payload)) {
            return normalizeRows(payload);
          }

          if (!payload || typeof payload !== "object") {
            return [];
          }

          const record = payload;

          for (const key of [
            "submissions",
            "data",
            "rows",
            "items",
            "values",
          ]) {
            if (Array.isArray(record[key])) {
              return normalizeRows(record[key]);
            }
          }

          return [];
        }

        function getField(row, names) {
          if (!row || typeof row !== "object") {
            return "";
          }

          const entries =
            Object.entries(row);

          for (const name of names) {
            const exactValue = row[name];

            if (
              exactValue !== undefined &&
              exactValue !== null &&
              String(exactValue).trim()
            ) {
              return String(exactValue).trim();
            }

            const normalizedName =
              name.toLowerCase().replace(/\s+/g, "");

            const looseEntry =
              entries.find(([key]) =>
                key
                  .toLowerCase()
                  .replace(/\s+/g, "") === normalizedName
              );

            if (
              looseEntry &&
              looseEntry[1] !== undefined &&
              looseEntry[1] !== null &&
              String(looseEntry[1]).trim()
            ) {
              return String(looseEntry[1]).trim();
            }
          }

          return "";
        }

        function getProblemMeta(value) {
          const digits =
            String(value).match(/\d+/)?.[0] ?? "";

          if (!digits) {
            return {
              display: String(value || "Unknown FE"),
              href: "",
            };
          }

          const id =
            digits.padStart(4, "0");

          return {
            display: `#${Number(digits)}`,
            href: `${base}/fe/${id}`,
          };
        }

        function shouldShowSubmission(row) {
          const status =
            getField(row, ["Status", "status"])
              .toLowerCase()
              .trim();

          return !statusLabelsToHide.has(status);
        }

        function getProblemNumberValue(row) {
          const problemNumber =
            getField(row, [
              "FE Number",
              "FE",
              "Problem",
              "Problem Number",
              "Number",
            ]);

          const digits =
            problemNumber.match(/\d+/)?.[0];

          return digits
            ? Number(digits)
            : Number.POSITIVE_INFINITY;
        }

        function createSubmissionElement(row, index) {
          const problemNumber =
            getField(row, [
              "FE Number",
              "FE",
              "Problem",
              "Problem Number",
              "Number",
            ]);

          const username =
            getField(row, [
              "Username",
              "Name",
              "User",
              "Submitter",
            ]);

          const solution =
            getField(row, [
              "Solution",
              "Submission",
              "Text",
              "Answer",
            ]);

          const problem =
            getProblemMeta(problemNumber);

          const item =
            document.createElement("details");

          item.className =
            "pending-card";

          item.dataset.submissionIndex =
            String(index);

          const summary =
            document.createElement("summary");

          summary.className =
            "pending-card-summary";

          summary.dataset.submissionSummary =
            String(index);

          const cardHeader =
            document.createElement("div");

          cardHeader.className =
            "pending-card-header";

          const problemHeading =
            document.createElement("h2");

          problemHeading.textContent =
            problem.display;

          const statusLabel =
            document.createElement("span");

          statusLabel.className =
            "pending-card-status";

          statusLabel.textContent =
            "pending";

          const summaryCopy =
            document.createElement("div");

          summaryCopy.className =
            "pending-card-copy";

          const summaryMeta =
            document.createElement("p");

          summaryMeta.className =
            "summary-meta";

          summaryMeta.textContent =
            username
              ? `Submitted by ${username}`
              : "Submitted solution";

          summaryCopy.append(summaryMeta);

          const chevron =
            document.createElement("span");

          chevron.className =
            "summary-chevron";

          chevron.setAttribute(
            "aria-hidden",
            "true"
          );

          const cardHeaderMeta =
            document.createElement("span");

          cardHeaderMeta.className =
            "pending-card-header-meta";

          if (problem.href) {
            const problemLink =
              document.createElement("a");

            problemLink.className =
              "problem-reference-link";

            problemLink.href =
              problem.href;

            problemLink.textContent =
              "View this problem";

            problemLink.addEventListener(
              "click",
              (event) => {
                event.stopPropagation();
              }
            );

            cardHeaderMeta.append(problemLink);
          }

          cardHeaderMeta.append(
            statusLabel,
            chevron
          );

          cardHeader.append(
            problemHeading,
            cardHeaderMeta
          );

          summary.append(
            cardHeader,
            summaryCopy
          );

          item.append(summary);

          const body =
            document.createElement("div");

          body.className =
            "pending-card-body";

          const expandedBox =
            document.createElement("div");

          expandedBox.className =
            "pending-card-details";

          const solutionElement =
            document.createElement("div");

          solutionElement.className =
            "submission-text";

          solutionElement.textContent =
            solution || "No solution text was provided.";

          expandedBox.append(solutionElement);

          body.append(expandedBox);
          item.append(body);

          function updateOpenState() {
            item.classList.toggle(
              "is-open",
              item.open
            );

            chevron.style.borderColor =
              item.open ? "#2e7d32" : "#617066";

            chevron.style.transform =
              item.open ? "rotate(225deg)" : "rotate(45deg)";
          }

          item.addEventListener(
            "toggle",
            updateOpenState
          );

          updateOpenState();

          return item;
        }

        async function loadPendingSubmissions() {
          if (!endpoint) {
            setStatus(
              "Pending submissions are not configured yet."
            );

            return;
          }

          refreshButton?.setAttribute("disabled", "");

          setStatus("Loading pending submissions...");

          try {
            const separator =
              endpoint.includes("?") ? "&" : "?";

            const response =
              await fetch(
                `${endpoint}${separator}cacheBust=${Date.now()}`,
                {
                  cache: "no-store",
                }
              );

            const text =
              await response.text();

            const trimmed =
              text.trim();

            if (
              !response.ok ||
              trimmed.startsWith("<!DOCTYPE") ||
              trimmed.startsWith("<html")
            ) {
              throw new Error("Endpoint is not public JSON.");
            }

            const payload =
              JSON.parse(trimmed);

            const rows =
              getRows(payload)
                .filter(shouldShowSubmission)
                .sort(
                  (firstRow, secondRow) =>
                    getProblemNumberValue(firstRow) -
                    getProblemNumberValue(secondRow)
                );

            if (countElement) {
              countElement.textContent =
                `${rows.length} awaiting review`;
            }

            if (!listElement) {
              return;
            }

            listElement.replaceChildren(
              ...rows.map(createSubmissionElement)
            );

            listElement.hidden =
              rows.length === 0;

            setStatus(
              rows.length
                ? "Open a submission card to view the solution."
                : "No pending submissions yet."
            );
          } catch {
            if (countElement) {
              countElement.textContent =
                "Unavailable";
            }

            if (listElement) {
              listElement.hidden =
                true;
            }

            setStatus(
              "Pending submissions could not be loaded. Check that the Apps Script web app access is set to Anyone."
            );
          } finally {
            refreshButton?.removeAttribute("disabled");
          }
        }

        refreshButton?.addEventListener(
          "click",
          loadPendingSubmissions
        );

        togglePendingButton?.addEventListener(
          "click",
          () => {
            const isVisible =
              !pendingContent?.hasAttribute("hidden");

            setPendingVisibility(!isVisible);
          }
        );

        loadPendingSubmissions();
      }
    </script>

    <style>
      body {
        font-family:
          system-ui,
          sans-serif;

        margin: 0;

        background: #f5f5f5;
        color: #111;
      }

      main {
        max-width: 1000px;
        margin: 0 auto;
        padding: 40px 20px 56px;
      }

      h1 {
        margin: 0 0 22px;
      }

      .form-panel {
        overflow: hidden;

        margin-top: 30px;

        background: white;
        border: 1px solid #e2e2e2;
        border-radius: 8px;

        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
      }

      iframe {
        display: block;
        width: 100%;
        min-height: 720px;

        border: 0;
      }

      .fallback-link {
        margin: 16px 0 0;
      }

      .fallback-link a {
        color: #2e7d32;
        font-weight: 650;
      }

      .pending-panel {
        margin: 0 0 30px;
      }

      .pending-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;

        margin-bottom: 18px;
      }

      h2 {
        margin: 0 0 5px;
        font-size: 1.35rem;
      }

      .pending-header p {
        margin: 0;

        color: #666;
        font-size: 0.95rem;
      }

      .pending-actions {
        display: flex;
        align-items: center;
        flex: 0 0 auto;
        gap: 10px;
      }

      .toggle-pending-button,
      .refresh-button {
        flex: 0 0 auto;

        min-height: 38px;
        padding: 8px 14px;

        border: 1px solid #cfd8cf;
        border-radius: 8px;

        background: #f8fbf8;
        color: #2e7d32;

        font: inherit;
        font-size: 0.9rem;
        font-weight: 700;

        cursor: pointer;
      }

      .refresh-button:hover {
        background: #ecf6ec;
      }

      .toggle-pending-button {
        background: #2e7d32;
        border-color: #2e7d32;
        color: white;
      }

      .toggle-pending-button:hover {
        background: #246c28;
      }

      .refresh-button:disabled {
        opacity: 0.6;
        cursor: wait;
      }

      .pending-content[hidden] {
        display: none;
      }

      .pending-status {
        margin: 0;

        color: #555;
        font-size: 0.95rem;
        line-height: 1.5;
      }

      .pending-list {
        display: grid;
        grid-template-columns:
          repeat(
            auto-fit,
            minmax(450px, 1fr)
          );
        align-items: start;
        gap: 16px;

        margin-top: 18px;
      }

      .pending-list[hidden] {
        display: none;
      }

      :global(.pending-card) {
        overflow: hidden;

        border-left: 6px solid #2e7d32;
        border-radius: 10px;

        background: #f0f9f1;
        color: inherit;

        transition:
          background 0.15s ease,
          border-color 0.15s ease;
      }

      :global(.pending-card:hover) {
        background: #e6f5e8;
      }

      :global(.pending-card.is-open) {
        background: #e6f5e8;
      }

      :global(.pending-card-summary) {
        display: grid;
        gap: 13px;

        padding: 20px;

        color: #111;

        cursor: pointer;
        list-style: none;
      }

      :global(.pending-card-summary::-webkit-details-marker) {
        display: none;
      }

      :global(.pending-card-summary:focus-visible) {
        outline: 3px solid rgba(46, 125, 50, 0.24);
        outline-offset: -3px;
      }

      :global(.pending-card-header) {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 16px;
      }

      :global(.pending-card-header h2) {
        margin: 0;
        font-size: 1.5rem;
      }

      :global(.pending-card-header-meta) {
        display: inline-flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 14px;
        justify-content: flex-end;
      }

      :global(.pending-card-status) {
        color: #2e7d32;
        font-weight: 700;
        text-transform: capitalize;
      }

      :global(.pending-card-copy) {
        min-width: 0;
      }

      :global(.summary-meta) {
        overflow: hidden;

        margin: 0;

        color: #667066;
        font-size: 0.95rem;
        font-weight: 560;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      :global(.summary-chevron) {
        width: 9px;
        height: 9px;

        border-right: 2px solid #617066;
        border-bottom: 2px solid #617066;

        transform: rotate(45deg);
        transition:
          border-color 0.15s ease,
          transform 0.15s ease;
      }

      :global(.pending-card[open] .summary-chevron),
      :global(.pending-card.is-open .summary-chevron) {
        border-color: #2e7d32;
        transform: rotate(225deg);
      }

      :global(.pending-card-body) {
        padding: 0 20px 20px;
      }

      :global(.pending-card-details) {
        margin: 0;
        padding-top: 16px;

        border-top: 1px solid rgba(46, 125, 50, 0.18);
      }

      :global(.submission-text) {
        margin: 0;

        color: #222;
        line-height: 1.6;
        overflow-wrap: anywhere;
        white-space: pre-wrap;
      }

      :global(.problem-reference-link) {
        color: #2e7d32;

        font-size: 0.92rem;
        font-weight: 800;
        text-decoration-color: rgba(46, 125, 50, 0.35);
        text-decoration-thickness: 2px;
        text-underline-offset: 4px;

        transition:
          color 0.15s ease;
      }

      :global(.problem-reference-link:hover) {
        color: #1d5f22;
      }

      @media (max-width: 600px) {
        main {
          padding: 24px 14px 44px;
        }

        iframe {
          min-height: 760px;
        }

        .pending-panel {
          margin-bottom: 22px;
        }

        .pending-header {
          align-items: stretch;
          flex-direction: column;
          gap: 12px;
        }

        .pending-actions {
          align-items: stretch;
          flex-direction: column;
        }

        .toggle-pending-button,
        .refresh-button {
          width: 100%;
        }

        .pending-list {
          grid-template-columns: 1fr;
        }

        :global(.pending-card-summary) {
          padding: 16px;
        }

        :global(.pending-card-copy) {
          width: 100%;
        }

        :global(.pending-card-body) {
          padding: 0 16px 16px;
        }
      }
    </style>
  </body>
</html>
